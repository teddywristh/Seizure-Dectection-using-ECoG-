{
  "defaults": {
    "artifact_subdir": "data_processing_v2",
    "raw_artifact_subdir": "data_processing_v2/raw_folds",
    "output_subdir": "experiments/dl",
    "batch_size": 64,
    "num_workers": 2,
    "epochs": 20,
    "learning_rate": 0.001,
    "weight_decay": 0.0001,
    "threshold": 0.5,
    "random_state": 42,
    "early_stopping_patience": 5,
    "device": "auto",
    "mixed_precision": "auto",
    "pin_memory": true,
    "non_blocking_transfers": true,
    "persistent_workers": true,
    "allow_tf32": true,
    "cudnn_benchmark": true,
    "raw_loading_strategy": "auto"
  },
  "presets": {
    "eegnet": {
      "model_name": "eegnet",
      "experiment_name": "eegnet",
