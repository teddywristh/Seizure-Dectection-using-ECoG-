        "dropout": 0.25
      }
    },
    "eegwavenet": {
      "model_name": "eegwavenet",
      "experiment_name": "eegwavenet",
      "input_mode": "raw"
    },
    "cnn_bilstm": {
      "model_name": "cnn_bilstm",
      "experiment_name": "cnn_bilstm",
      "input_mode": "raw"
    },
    "bendr": {
      "model_name": "bendr",
      "experiment_name": "bendr",
      "input_mode": "raw"
    },
    "reve": {
      "model_name": "reve",
      "experiment_name": "reve",
      "input_mode": "raw"
    },
    "biseizurere": {
      "model_name": "biseizurere",
      "experiment_name": "biseizurere_proxy",
